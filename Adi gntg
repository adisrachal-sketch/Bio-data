import javax.swing.*;
import java.awt.*;

public class Animasi34 extends JFrame {
    private int x = 0;
    private boolean arahKanan = true;

    public Animasi34() {
        setTitle("Nomor 34");
        setSize(600, 150);
        setDefaultCloseOperation(EXIT_ON_CLOSE);
        setVisible(true);

        Timer timer = new Timer(30, e -> {
            if (arahKanan) {
                x += 3;
                if (x >= 550) arahKanan = false;
            } else {
                x -= 3;
                if (x <= 0) arahKanan = true;
            }
            repaint();
        });
        timer.start();
    }

    @Override
    public void paint(Graphics g) {
        super.paint(g);
        g.setFont(new Font("Arial", Font.BOLD, 40));
        g.drawString("0", x, 50);
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(Animasi34::new);
    }
}

