import java.util.Scanner;
public class FibonacciMaks {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);
        System.out.print("Masukkan nilai maksimal: ");
        int maks = input.nextInt();
        int a=0, b=1;
        while(a <= maks){
            System.out.print(a+" ");
            int temp = a;
            a = b;
            b = temp + b;
        }
    }
}

